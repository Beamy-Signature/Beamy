# Public site works with built-in mock catalogue until these are set.
# After creating a Supabase project:
# 1. Run supabase/schema.sql in the SQL editor
# 2. Run supabase/seed.sql
# 3. Create an Auth user manually (email + password) — no public sign-up
# 4. Fill the values below and restart the app

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Combined by default: one process serves the website and /admin.
# For separate deploys, set both to "web" or both to "admin" and use
# npm run build:web / npm run build:admin (see DEPLOY.md).
# APP_TARGET=all
# NEXT_PUBLIC_APP_TARGET=all

# Public website URL — used by the admin "View website" link on CMS-only deploys.
# NEXT_PUBLIC_SITE_URL=https://beamy.fashion
